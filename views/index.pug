extends layout.pug

block title
  | 题目列表 - 题目列表

mixin difficultyBadge(difficulty)
  - const value = difficulty || ''
  - const difficultyMap = {'入门': 'entry', '普及-': 'basic', '普及/提高-': 'intermediate-minus', '普及+/提高': 'intermediate', '提高+/省选-': 'advanced-minus', '省选/NOI-': 'advanced', 'NOI/NOI+/CTSC': 'elite', '未知': 'unknown'}
  - const difficultyClass = `difficulty-${difficultyMap[value] || 'unknown'}`
  span.problem-difficulty-badge(class=difficultyClass) #{value || '未知'}

mixin favoriteIcon()
  svg.favorite-icon(xmlns="http://www.w3.org/2000/svg", viewBox="0 0 24 24", fill="currentColor", aria-hidden="true", focusable="false")
    path(d="m12 3.4 2.65 5.38 5.94.86-4.3 4.19 1.02 5.92L12 16.96l-5.31 2.79 1.02-5.92-4.3-4.19 5.94-.86L12 3.4z")

block content
  .index-shell
    .index-head
      .index-head__title
        h1.h3.mb-1 题目列表
        p.text-muted.mb-0 可按标题、OJ、标签和启发记录快速筛选题目解析。
      .index-head__meta
        if currentFavorite
          span.index-count 共 #{pagination.total} 道启发题
        else
          span.index-count 共 #{pagination.total} 题

    .index-toolbar
      form.index-search(action="/", method="GET")
        input.form-control(type="search", name="q", placeholder="搜索标题、题号或启发记录", value=query)
        if currentOJ
          input(type="hidden", name="oj", value=currentOJ)
        if currentTag
          input(type="hidden", name="tag", value=currentTag)
        if currentFavorite
          input(type="hidden", name="favorite", value="true")
        button.btn.btn-primary(type="submit") 搜索
      .index-filters
        select.form-select(name="oj", onchange="filterByOJ(this.value)")
          option(value="") 全部 OJ
          each oj in ojs
            option(value=oj, selected=oj === currentOJ) #{oj}
        .index-tag-filter
          button.btn.btn-outline-secondary.index-tag-filter__trigger(
            type="button"
            data-bs-toggle="modal"
            data-bs-target="#tagFilterModal"
            aria-controls="tagFilterModal"
            aria-haspopup="dialog"
          )
            span.text-truncate
              if currentTag
                | 标签：#{currentTag}
              else
                | 选择标签（#{tagOptions.length}）
            span.index-tag-filter__chevron(aria-hidden="true") ▾
          if currentTag
            button.btn.btn-outline-secondary.index-tag-filter__clear(
              type="button"
              data-tag-clear
              aria-label=`清除标签 ${currentTag}`
              title="清除标签"
            )
              span(aria-hidden="true") ×
        label.index-favorite-filter
          input.form-check-input(
            type="checkbox"
            checked=currentFavorite
            onchange="filterByFavorite(this.checked)"
            aria-label="只看启发题"
          )
          span.index-favorite-filter__icon(role="img", aria-hidden="true")
            +favoriteIcon()
          span 只看启发题

    .table-responsive.index-table-wrap
      table.table.table-hover.align-middle.index-table
        thead
          tr
            th(scope="col") 标题
            th(scope="col") OJ
            th(scope="col") 题号
            th(scope="col") 标签
            th(scope="col") 难度
            th(scope="col") 最后更新
            th(scope="col") 原题
        tbody
          if problems.length
            each problem in problems
              tr
                td.index-table__title
                  .index-table__title-line
                    if problem.favorite
                      - const favoriteLabel = problem.favorite_reason ? `启发题：${problem.favorite_reason}` : '启发题'
                      span.index-favorite-marker(
                        role="img"
                        tabindex="0"
                        aria-label=favoriteLabel
                        title=favoriteLabel
                      )
                        +favoriteIcon()
                    a.index-table__title-link(href=problem.url) #{problem.title}
                  if problem.description
                    .index-table__description #{problem.description}
                td
                  span.index-pill #{problem.oj}
                td
                  code.index-code #{problem.problem_id}
                td
                  if problem.tags && problem.tags.length
                    .index-tags
                      each tag in problem.tags
                        span.badge.text-bg-light.index-tag #{tag}
                  else
                    span.text-muted -
                td
                  if problem.difficulty
                    +difficultyBadge(problem.difficulty)
                  else
                    span.text-muted -
                td
                  if problem.date
                    span.text-nowrap #{problem.date}
                  else
                    span.text-muted -
                td
                  if problem.source
                    a.btn.btn-sm.btn-outline-secondary(href=problem.source, target="_blank", rel="noopener noreferrer") 打开
                  else
                    span.text-muted -
          else
            tr
              td.index-empty(colspan="7")
                if currentFavorite
                  | 暂无标记为启发题的题解。
                else
                  | 没有符合当前筛选条件的题解。

  if pagination
    nav.index-pagination(aria-label="分页")
      .index-pagination__summary
        if pagination.total
          | 显示第 #{pagination.startItem}-#{pagination.endItem} 条，共 #{pagination.total} 题
        else
          | 共 0 题
      if pagination.totalPages > 1
        .index-pagination__body
          ul.pagination
            if pagination.page > 1
              li.page-item
                a.page-link(href=pageUrl(pagination.page - 1), aria-label="上一页", title="上一页")
                  span(aria-hidden="true") ‹

            each item in pagination.items
              if item === 'ellipsis'
                li.page-item.disabled(aria-hidden="true")
                  span.page-link …
              else if item === pagination.page
                li.page-item.active
                  span.page-link(aria-current="page") #{item}
              else
                li.page-item
                  a.page-link(href=pageUrl(item)) #{item}

            if pagination.page < pagination.totalPages
              li.page-item
                a.page-link(href=pageUrl(pagination.page + 1), aria-label="下一页", title="下一页")
                  span(aria-hidden="true") ›

          form.index-pagination__jump(action="/", method="GET")
            if query
              input(type="hidden", name="q", value=query)
            if currentOJ
              input(type="hidden", name="oj", value=currentOJ)
            if currentTag
              input(type="hidden", name="tag", value=currentTag)
            if currentFavorite
              input(type="hidden", name="favorite", value="true")
            label.visually-hidden(for="index-page-jump") 跳转到页码
            span.index-pagination__jump-label 第
            input#index-page-jump.index-pagination__jump-input.form-control(
              type="number"
              name="page"
              min="1"
              max=pagination.totalPages
              value=pagination.page
              inputmode="numeric"
            )
            span.index-pagination__jump-total / #{pagination.totalPages} 页
            button.btn.btn-outline-secondary(type="submit") 跳转

  #tagFilterModal.modal.fade(
    tabindex="-1"
    aria-labelledby="tagFilterModalLabel"
    aria-hidden="true"
  )
    .modal-dialog.modal-lg.modal-dialog-scrollable.modal-fullscreen-sm-down
      .modal-content
        .modal-header
          h2#tagFilterModalLabel.modal-title.fs-5 选择标签
          button.btn-close(type="button", data-bs-dismiss="modal", aria-label="关闭")
        .modal-body.tag-filter-modal__body
          .tag-filter-search
            label.visually-hidden(for="tagFilterSearch") 搜索标签
            input#tagFilterSearch.form-control(
              type="search"
              placeholder="搜索标签"
              autocomplete="off"
              spellcheck="false"
              aria-controls="tagFilterOptions"
            )
            #tagFilterResultCount.tag-filter-search__count(role="status", aria-live="polite")
              | 共 #{tagOptions.length} 个标签

          if tagOptions.length
            section.tag-filter-section(data-tag-popular)
              h3.tag-filter-section__title 常用标签
              .tag-filter-grid(role="listbox", aria-label="常用标签")
                each option in tagOptions.slice(0, 12)
                  button.tag-filter-option(
                    type="button"
                    class=option.name === currentTag ? "is-selected" : ""
                    data-tag-option
                    data-tag-name=option.name
                    role="option"
                    aria-selected=option.name === currentTag ? "true" : "false"
                  )
                    span.tag-filter-option__name #{option.name}
                    span.tag-filter-option__meta
                      span.tag-filter-option__count #{option.count}
                      span.tag-filter-option__check(aria-hidden="true") ✓

          section.tag-filter-section
            .tag-filter-section__head
              h3.tag-filter-section__title 全部标签
              span.tag-filter-section__total #{tagOptions.length} 个
            .tag-filter-grid#tagFilterOptions(data-tag-list, role="listbox", aria-label="全部标签")
              button.tag-filter-option(
                type="button"
                class=!currentTag ? "is-selected" : ""
                data-tag-option
                data-tag-name=""
                role="option"
                aria-selected=!currentTag ? "true" : "false"
              )
                span.tag-filter-option__name 全部标签
                span.tag-filter-option__meta
                  span.tag-filter-option__count #{tagScopeTotal}
                  span.tag-filter-option__check(aria-hidden="true") ✓
              each option in tagOptions
                button.tag-filter-option(
                  type="button"
                  class=option.name === currentTag ? "is-selected" : ""
                  data-tag-option
                  data-tag-name=option.name
                  role="option"
                  aria-selected=option.name === currentTag ? "true" : "false"
                )
                  span.tag-filter-option__name #{option.name}
                  span.tag-filter-option__meta
                    span.tag-filter-option__count #{option.count}
                    span.tag-filter-option__check(aria-hidden="true") ✓
            p#tagFilterEmpty.tag-filter-empty(hidden) 没有匹配的标签

block scripts
  script.
    function filterByOJ(oj) {
      const url = new URL(window.location);
      if (oj) {
        url.searchParams.set('oj', oj);
      } else {
        url.searchParams.delete('oj');
      }
      url.searchParams.delete('page');
      window.location = url;
    }

    function filterByFavorite(favorite) {
      const url = new URL(window.location);
      if (favorite) {
        url.searchParams.set('favorite', 'true');
      } else {
        url.searchParams.delete('favorite');
      }
      url.searchParams.delete('page');
      window.location = url;
    }
  script(src="/javascripts/tag-filter-modal.js")
