{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pre 关系 worker 裁定结果（一行一条 JSON）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "attempt", "key", "verdict", "a_step", "b_use",
    "quote_a", "src_a", "quote_b", "src_b", "confidence", "model"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[^\\s]+$", "_pattern_note": "原为 ^[A-Za-z0-9._-]+$，与实现不符：批次 task_id 含中文分片名（如 pre-new-20261005-01背包-1146）。prebatch_lib._sanitize 明确允许中文出现在 task_id/shard_id/路径中；且实际校验器 validate_result 是手写实现、不走 jsonschema，根本不检查本正则（故原值是死规则）。修正为与实现一致，避免日后用 jsonschema 校验时全盘失败。" },
    "attempt": { "type": "integer", "minimum": 1 },
    "key": { "type": "string", "pattern": "^[^\\s]+/[^\\s]+->[^\\s]+/[^\\s]+$" },
    "verdict": { "type": "string", "enum": ["accept", "reject", "doubtful"] },
    "reject_reason": {
      "type": "string",
      "enum": ["", "same-difficulty-twin", "b-difficulty-elsewhere", "no-reuse",
               "direction-wrong", "insufficient-evidence", "self-or-duplicate"]
    },
    "a_step": { "type": "string", "maxLength": 80 },
    "b_use": { "type": "string", "maxLength": 80 },
    "quote_a": { "type": "string", "minLength": 2, "maxLength": 40 },
    "quote_b": { "type": "string", "minLength": 2, "maxLength": 40 },
    "src_a": { "type": "string", "pattern": "^problems/.+\\.md:\\d+$" },
    "src_b": { "type": "string", "pattern": "^problems/.+\\.md:\\d+$" },
    "reason": { "type": "string", "maxLength": 300 },
    "strength": { "type": "string", "enum": ["", "strong", "template-level"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "model": { "type": "string" },
    "solution_branch": { "type": "string", "maxLength": 80 },
    "evidence_hash_a": { "type": "string" },
    "evidence_hash_b": { "type": "string" },
    "created_at": { "type": "string" }
  }
}
